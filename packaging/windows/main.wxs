<?xml version="1.0" encoding="UTF-8"?>
<!--
  Windows 安装包定义（WiX v3，草案）。
  由 .github/workflows/release-target.yml 的 windows 目标调用：
    candle -dSourceDir=<release 目录> -dExeName=<exe> -dProductVersion=<x.y.z> \
           -dUpgradeCode=<稳定的 GUID> main.wxs
    light -ext WixUIExtension -o <target>-<version>.msi main.wixobj
  真正的代码签名（signtool）在 CI 里标注为模拟（无证书）。

  进 msi 的字符串一律只能是 ASCII：库的代码页是 1252，装不下中文，light 会以 LGHT0311
  拒绝。给 Product 加 Codepage="936" 试过一次，没用——它没改到库的代码页（light 报的
  还是 '1252'）。要让安装包说中文，得走 WixLocalization（zh-CN + Codepage）那条路。

  位数要说两处：Package/@Platform="x64" 说这个包是 64 位的（摘要里的平台），组件则要
  自己写 Win64="yes"——只加 Platform 试过了，light 照样以 ICE80 拒
  （32BitComponent 用了 64BitDirectory），这个版本不会把包的位数传到组件上。
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="GitHub Action Console"
    Language="1033"
    Version="$(var.ProductVersion)"
    Manufacturer="github-action-console"
    UpgradeCode="$(var.UpgradeCode)"
  >
    <Package
      InstallerVersion="500"
      Compressed="yes"
      InstallScope="perMachine"
      Platform="x64"
    />
    <!-- 这句话会进 msi，所以是英文：安装包本身（产品名、厂商、目录）也都是英文，
         语言是 1033。中文提示要等本地化那条路。 -->
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="GitHub Action Console">
          <Component Id="ConsoleExe" Guid="*" Win64="yes">
            <File
              Id="ConsoleExeFile"
              Source="$(var.SourceDir)\$(var.ExeName)"
              KeyPath="yes"
            />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="Main" Title="GitHub Action Console" Level="1">
      <ComponentRef Id="ConsoleExe" />
    </Feature>
  </Product>
</Wix>
